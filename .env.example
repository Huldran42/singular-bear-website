# Public site origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
# Local: http://localhost:3000
# Vercel preview: leave unset — the app uses https://$VERCEL_URL
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. If empty, the donate button is hidden.
NEXT_PUBLIC_PAYPAL_URL=

# Public contact address shown on Support.
NEXT_PUBLIC_CONTACT_EMAIL=singularbear.studio@gmail.com

# Optional overrides for studio links.
NEXT_PUBLIC_ASSET_STORE_URL=https://assetstore.unity.com/publishers/102041
NEXT_PUBLIC_ARTSTATION_URL=https://www.artstation.com/singularbearstudio1/profile
